# NexTech Enterprise Hardware E-Commerce - Frontend Environment Variables Template
# Copy this file to frontend/.env.local

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Server-side JWT signing key; must match backend/.env JWT_SECRET and be at least 32 characters.
# Generate a random secret and set it in both environments. Do not use a fixed sample value.
JWT_SECRET=

# Firebase Web Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Analytics 4 (GA4) Tracking Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Bot Defense & Anti-DDoS Turnstile Keys
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_YOUR_SITE_KEY
NEXT_PUBLIC_CLOUDFLARE_PROTECTION_ENABLED=true
