# NexTech Enterprise Hardware E-Commerce - Backend API Environment Variables Template
# Copy this file to backend/.env

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001


# Authentication & Cryptographic Secrets
JWT_SECRET=your_jwt_secret_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_storage_bucket.firebasestorage.app
ENABLE_FIRESTORE_SYNC=true

# Google Analytics 4 (GA4) Server Telemetry API Secrets
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=your_google_analytics_property_id
GA_API_SECRET=your_google_analytics_api_secret

# Cloudflare Edge CDN, Bot Defense & Anti-DDoS Protection
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_YOUR_SECRET_KEY
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_SECURITY_ENABLED=true
DDOS_RATE_LIMIT_WINDOW_MS=60000
DDOS_RATE_LIMIT_MAX_REQUESTS=120

# MongoDB Enterprise Cloud Database Cluster
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=nextech_ecommerce
ENABLE_MONGODB=true

# Transactional Email & Order Verification Security
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=NexTech Security <no-reply@nextech.ae>
REQUIRE_ORDER_EMAIL_OTP=true

# Tamara BNPL Integration (Sandbox: https://api-sandbox.tamara.co | Production: https://api.tamara.co)
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=your_tamara_merchant_token
TAMARA_NOTIFICATION_TOKEN=your_tamara_notification_webhook_token
TAMARA_PUBLIC_KEY=your_tamara_public_key

# Tabby BNPL Integration (Production: https://api.tabby.ai)
TABBY_API_URL=https://api.tabby.ai
TABBY_SECRET_KEY=sk_test_xxxxxx
TABBY_PUBLIC_KEY=pk_test_xxxxxx
TABBY_MERCHANT_CODE=nextech_ae


