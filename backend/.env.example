# NexTech Enterprise Hardware E-Commerce - Backend API Environment Variables

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket.firebasestorage.app
ENABLE_FIRESTORE_SYNC=true

# Google Analytics 4 (GA4) Server Telemetry API Secrets
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=your_google_analytics_property_id
GA_API_SECRET=your_google_analytics_api_secret

# Cloudflare Edge CDN, Bot Defense & Anti-DDoS Protection
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_YOUR_SECRET_KEY
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_SECURITY_ENABLED=true
DDOS_RATE_LIMIT_WINDOW_MS=60000
DDOS_RATE_LIMIT_MAX_REQUESTS=120
