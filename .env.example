# NexTech Enterprise Hardware E-Commerce - Root Environment Configuration Template
# Copy this file to .env or configure respective frontend/.env.local and backend/.env

# ==============================================================================
# 1. Platform & Server Settings
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ==============================================================================
# 2. Authentication & Cryptographic Secrets
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_here_generate_with_openssl_rand_hex_32
INITIAL_ADMIN_EMAIL=admin@nextech.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here

# ==============================================================================
# 3. Firebase Web Client & Admin SDK Configuration
# ==============================================================================
# Client / Frontend
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend Admin SDK (Optional: for server-side auth claims & storage)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
ENABLE_FIRESTORE_SYNC=true

# ==============================================================================
# 4. Google Analytics 4 (GA4) Telemetry Secrets
# ==============================================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_PROPERTY_ID=your_ga_property_id
GA_API_SECRET=your_ga_measurement_protocol_api_secret

# ==============================================================================
# 5. Cloudflare CDN, Edge Security & Turnstile Bot Defense
# ==============================================================================
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_YOUR_SITE_KEY
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_YOUR_SECRET_KEY
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_SECURITY_ENABLED=true
DDOS_RATE_LIMIT_WINDOW_MS=60000
DDOS_RATE_LIMIT_MAX_REQUESTS=120
