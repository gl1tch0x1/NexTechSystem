rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for hardware catalog products, categories, brands, and banners
    // Writes are restricted exclusively to backend server processes (Firebase Admin SDK)
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /brands/{brandId} {
      allow read: if true;
      allow write: if false;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if false;
    }

    // Authenticated access scoped strictly to the authenticated user ID (Tenant Isolation)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false; // Orders are generated and updated exclusively via backend APIs
    }

    // Financial & Ledger collections: client write is strictly forbidden
    match /wallets/{walletId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /wallet_transactions/{txId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /ebills/{ebillId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /resellers/{resellerId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if false; // Audit logs accessible exclusively via authenticated Admin SDK
      allow write: if false;
    }

    // Default fail-closed fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
