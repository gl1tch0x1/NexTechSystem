rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for hardware catalog products, categories, brands, and banners
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /brands/{brandId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Authenticated access for users, orders, wallets, e-bills
    match /users/{userId} {
      allow read, write: if true; // or request.auth != null
    }

    match /orders/{orderId} {
      allow read, write: if true; // or request.auth != null
    }

    match /wallets/{walletId} {
      allow read, write: if true; // or request.auth != null
    }

    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }

    match /ebills/{ebillId} {
      allow read, write: if true;
    }

    match /resellers/{resellerId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
